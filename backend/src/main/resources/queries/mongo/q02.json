{
  "id": 2,
  "titulo": "Cantidad de aprobados por materia",
  "descripcion": "Número de evaluaciones aprobadas en cada materia.",
  "coleccion": "evaluaciones",
  "parametros": [],
  "pipeline": [
    {
      "$match": {
        "aprobado": true
      }
    },
    {
      "$group": {
        "_id": "$materia",
        "aprobadas": {
          "$sum": 1
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "materia": "$_id",
        "aprobadas": 1
      }
    },
    {
      "$sort": {
        "aprobadas": -1
      }
    }
  ]
}
