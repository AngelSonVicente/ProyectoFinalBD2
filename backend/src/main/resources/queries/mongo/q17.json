{
  "id": 17,
  "titulo": "Top 5 municipios con mayor cantidad de aspirantes",
  "descripcion": "Los cinco municipios de las instituciones de procedencia con más aspirantes distintos. Se excluyen los registros sin municipio.",
  "coleccion": "evaluaciones",
  "parametros": [],
  "pipeline": [
    {
      "$match": {
        "municipio": {
          "$ne": "SIN REGISTRO"
        }
      }
    },
    {
      "$group": {
        "_id": {
          "departamento": "$departamento",
          "municipio": "$municipio",
          "aspirante": "$correlativo_aspirante"
        }
      }
    },
    {
      "$group": {
        "_id": {
          "departamento": "$_id.departamento",
          "municipio": "$_id.municipio"
        },
        "aspirantes": {
          "$sum": 1
        }
      }
    },
    {
      "$sort": {
        "aspirantes": -1
      }
    },
    {
      "$limit": 5
    },
    {
      "$project": {
        "_id": 0,
        "departamento": "$_id.departamento",
        "municipio": "$_id.municipio",
        "aspirantes": 1
      }
    }
  ]
}
