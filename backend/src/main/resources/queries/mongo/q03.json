{
  "id": 3,
  "titulo": "Aprobados por carrera y año de ingreso",
  "descripcion": "Aspirantes distintos con al menos una evaluación aprobada, agrupados por carrera objetivo y año de ingreso.",
  "coleccion": "evaluaciones",
  "parametros": [],
  "pipeline": [
    {
      "$match": {
        "aprobado": true
      }
    },
    {
      "$group": {
        "_id": {
          "carrera": "$carrera_objetivo",
          "anio": "$anio_ingreso",
          "aspirante": "$correlativo_aspirante"
        }
      }
    },
    {
      "$group": {
        "_id": {
          "carrera": "$_id.carrera",
          "anio": "$_id.anio"
        },
        "aspirantes_aprobados": {
          "$sum": 1
        }
      }
    },
    {
      "$project": {
        "_id": 0,
        "carrera_objetivo": "$_id.carrera",
        "anio_ingreso": "$_id.anio",
        "aspirantes_aprobados": 1
      }
    },
    {
      "$sort": {
        "anio_ingreso": 1,
        "aspirantes_aprobados": -1
      }
    }
  ]
}
