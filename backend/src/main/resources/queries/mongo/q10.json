{
  "id": 10,
  "titulo": "Top 5 carreras más demandadas por aspirantes de 16 a 18 años",
  "descripcion": "Las cinco carreras objetivo con más aspirantes distintos de entre 16 y 18 años. Se excluye SIN CARRERA porque no representa una carrera.",
  "coleccion": "evaluaciones",
  "parametros": [],
  "pipeline": [
    {
      "$match": {
        "edad": {
          "$gte": 16,
          "$lte": 18
        },
        "carrera_objetivo": {
          "$ne": "SIN CARRERA"
        }
      }
    },
    {
      "$group": {
        "_id": {
          "carrera": "$carrera_objetivo",
          "aspirante": "$correlativo_aspirante"
        }
      }
    },
    {
      "$group": {
        "_id": "$_id.carrera",
        "aspirantes": {
          "$sum": 1
        }
      }
    },
    {
      "$sort": {
        "aspirantes": -1,
        "_id": 1
      }
    },
    {
      "$limit": 5
    },
    {
      "$project": {
        "_id": 0,
        "carrera_objetivo": "$_id",
        "aspirantes": 1
      }
    }
  ]
}
