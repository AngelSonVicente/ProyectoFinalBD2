# Copiar a .env y ajustar si es necesario.
# docker-compose usa MONGO_* y NEO4J_*; el backend usa MONGO_URI y NEO4J_*.

MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_URI=mongodb://admin:admin123@localhost:27017/pruebas_especificas?authSource=admin

NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j12345
NEO4J_URI=bolt://localhost:7687

SERVER_PORT=8080
CORS_ORIGINS=http://localhost:4200
